MONCASH_CLIENT_ID=your_client_id_here
MONCASH_CLIENT_SECRET=your_client_secret_here
MONCASH_SECRET_API_KEY=your_secret_api_key_here
MONCASH_BUSINESS_KEY=your_business_key_here
MONCASH_API_BASE=https://moncashbutton.digicelgroup.com/Api
MONCASH_GATEWAY_BASE=https://moncashbutton.digicelgroup.com/Moncash-middleware
MONCASH_CURRENCY=HTG
PUBLIC_SITE_URL=https://smartcutservices.com

# WhatsApp Business Cloud API - set the real values with Firebase Secret
# Manager, never in a committed .env file. Marketing is disabled by default
# and must only be enabled in the WhatsApp admin module after Meta approves
# the configured templates.
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=your_random_webhook_verify_token
WHATSAPP_GRAPH_API_VERSION=v23.0
